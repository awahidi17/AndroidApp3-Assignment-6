<?xml version="1.0" encoding="utf-8"?>
<!-- Custom Google Map marker card adapted from PlaceBook's custom info window topic. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:background="@drawable/map_info_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/infoStopText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/info_stop_placeholder"
        android:textColor="@color/coral_dark"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/infoNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:text="@string/mystery_stop"
        android:textColor="@color/navy"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/infoAddressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:text="@string/address_placeholder"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/infoActionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/info_current_action"
        android:textColor="@color/purple"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
