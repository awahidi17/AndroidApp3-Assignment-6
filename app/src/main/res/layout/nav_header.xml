<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="210dp"
    android:background="@drawable/gradient_header"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/badge_circle_white"
        android:gravity="center"
        android:text="@string/map_symbol"
        android:textColor="@color/purple"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/windsor_quest_upper"
        android:textColor="@color/aqua"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/treasure_hunt"
        android:textColor="@color/white"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/created_by_ahmad"
        android:textColor="@color/purple_light_text"
        android:textSize="13sp" />
</LinearLayout>
